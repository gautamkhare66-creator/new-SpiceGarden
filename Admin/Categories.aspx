<%@ Page Title="Category Management" Language="C#" MasterPageFile="../Site.Master" AutoEventWireup="true" CodeBehind="Categories.aspx.cs" Inherits="SpiceGardenWebForms.Admin.Categories" %>
<asp:Content ID="MainContent" runat="server" ContentPlaceHolderID="MainContent"><section class="container py-5"><h1>Category Management</h1><form class="row g-3 mb-4" runat="server"><div class="col-md-5"><label class="form-label">Category name</label><asp:TextBox ID="CategoryNameInput" runat="server" CssClass="form-control" /><asp:RequiredFieldValidator ControlToValidate="CategoryNameInput" ErrorMessage="Category name is required." runat="server" /></div><div class="col-md-5"><label class="form-label">Description</label><asp:TextBox ID="DescriptionInput" runat="server" CssClass="form-control" /></div><div class="col-md-2 d-flex align-items-end"><asp:Button ID="SaveButton" runat="server" CssClass="btn btn-dark-green" Text="Save" OnClick="SaveButton_Click" /></div></form><asp:Label ID="Message" runat="server" CssClass="success-message" /><asp:GridView ID="CategoriesGrid" runat="server" CssClass="table table-striped mt-3" AutoGenerateColumns="false" AllowPaging="true" PageSize="10" OnRowCommand="CategoriesGrid_RowCommand"><Columns><asp:BoundField DataField="CategoryId" HeaderText="ID" /><asp:BoundField DataField="CategoryName" HeaderText="Category" /><asp:BoundField DataField="Description" HeaderText="Description" /><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:Button ID="EditButton" runat="server" CommandName="Edit" CommandArgument="<%# Container.DataItem.CategoryId %>" CssClass="btn btn-sm btn-outline-dark" Text="Edit" /><asp:Button ID="DeleteButton" runat="server" CommandName="Delete" CommandArgument="<%# Container.DataItem.CategoryId %>" CssClass="btn btn-sm btn-danger ms-1" Text="Delete" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></section></asp:Content>