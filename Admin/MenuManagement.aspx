<%@ Page Title="Menu Management" Language="C#" MasterPageFile="../Site.Master" AutoEventWireup="true" CodeBehind="MenuManagement.aspx.cs" Inherits="SpiceGardenWebForms.Admin.MenuManagement" %>
<asp:Content ID="MainContent" runat="server" ContentPlaceHolderID="MainContent"><section class="container py-5"><h1>Menu Management</h1><form class="row g-3 mb-4" runat="server"><div class="col-md-3"><label class="form-label">Category</label><asp:DropDownList ID="CategoryInput" runat="server" CssClass="form-select" /></div><div class="col-md-3"><label class="form-label">Item name</label><asp:TextBox ID="ItemNameInput" runat="server" CssClass="form-control" /><asp:RequiredFieldValidator ControlToValidate="ItemNameInput" ErrorMessage="Item name is required." runat="server" /></div><div class="col-md-3"><label class="form-label">Price</label><asp:TextBox ID="PriceInput" runat="server" CssClass="form-control" TextMode="Number" /><asp:RangeValidator ControlToValidate="PriceInput" Type="Double" MinimumValue="0" ErrorMessage="Price cannot be negative." runat="server" /></div><div class="col-md-3"><label class="form-label">Available</label><asp:CheckBox ID="AvailableInput" runat="server" Checked="true" /></div><div class="col-md-4"><label class="form-label">Description</label><asp:TextBox ID="DescriptionInput" runat="server" CssClass="form-control" /></div><div class="col-md-4"><label class="form-label">Image URL</label><asp:TextBox ID="ImageUrlInput" runat="server" CssClass="form-control" /></div><div class="col-md-4 d-flex align-items-end"><asp:Button ID="SaveButton" runat="server" CssClass="btn btn-dark-green" Text="Save" OnClick="SaveButton_Click" /></div></form><asp:Label ID="Message" runat="server" CssClass="success-message" /><asp:GridView ID="MenuGrid" runat="server" CssClass="table table-striped mt-3" AutoGenerateColumns="false" AllowPaging="true" PageSize="10" OnRowCommand="MenuGrid_RowCommand"><Columns><asp:BoundField DataField="ItemName" HeaderText="Item" /><asp:BoundField DataField="CategoryName" HeaderText="Category" /><asp:BoundField DataField="Description" HeaderText="Description" /><asp:TemplateField HeaderText="Price"><ItemTemplate><%# Eval("Price", "{0:C}") %></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Available"><ItemTemplate><%# Eval("IsAvailable") %></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:Button ID="EditButton" runat="server" CommandName="Edit" CommandArgument="<%# Container.DataItem.MenuItemId %>" CssClass="btn btn-sm btn-outline-dark" Text="Edit" /><asp:Button ID="DeleteButton" runat="server" CommandName="Delete" CommandArgument="<%# Container.DataItem.MenuItemId %>" CssClass="btn btn-sm btn-danger ms-1" Text="Delete" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></section></asp:Content>