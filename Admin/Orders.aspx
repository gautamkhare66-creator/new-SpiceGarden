<%@ Page Title="Order Management" Language="C#" MasterPageFile="../Site.Master" AutoEventWireup="true" CodeBehind="Orders.aspx.cs" Inherits="SpiceGardenWebForms.Admin.Orders" %>
<asp:Content ID="MainContent" runat="server" ContentPlaceHolderID="MainContent"><section class="container py-5"><h1>Order Management</h1><div class="input-group mb-3"><asp:TextBox ID="SearchInput" runat="server" CssClass="form-control" placeholder="Search status or address" /><asp:Button ID="SearchButton" runat="server" CssClass="btn btn-dark-green" Text="Search" OnClick="SearchButton_Click" /></div><asp:GridView ID="OrdersGrid" runat="server" CssClass="table table-striped" AutoGenerateColumns="false" AllowPaging="true" PageSize="10" OnRowCommand="OrdersGrid_RowCommand"><Columns><asp:BoundField DataField="OrderId" HeaderText="Order ID" /><asp:BoundField DataField="OrderDate" HeaderText="Date" DataFormatString="{0:dd/MM/yyyy}" /><asp:BoundField DataField="Status" HeaderText="Status" /><asp:TemplateField HeaderText="Total"><ItemTemplate><%# Eval("TotalAmount", "{0:C}") %></ItemTemplate></asp:TemplateField><asp:BoundField DataField="DeliveryAddress" HeaderText="Address" /><asp:TemplateField HeaderText="Actions"><ItemTemplate><asp:DropDownList ID="StatusSelect" runat="server" CssClass="form-select d-inline w-auto"><asp:ListItem Text="Pending" Value="Pending" /><asp:ListItem Text="Confirmed" Value="Confirmed" /><asp:ListItem Text="Preparing" Value="Preparing" /><asp:ListItem Text="Out for Delivery" Value="Out for Delivery" /><asp:ListItem Text="Delivered" Value="Delivered" /><asp:ListItem Text="Cancelled" Value="Cancelled" /></asp:DropDownList><asp:Button ID="UpdateStatusButton" runat="server" CommandName="Update" CommandArgument="<%# Container.DataItem.OrderId %>" CssClass="btn btn-sm btn-gold ms-1" Text="Update" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></section></asp:Content>