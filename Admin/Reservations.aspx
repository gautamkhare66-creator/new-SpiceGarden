<%@ Page Title="Reservation Management" Language="C#" MasterPageFile="../Site.Master" AutoEventWireup="true" CodeBehind="Reservations.aspx.cs" Inherits="SpiceGardenWebForms.Admin.Reservations" %>
<asp:Content ID="MainContent" runat="server" ContentPlaceHolderID="MainContent"><section class="container py-5"><h1>Reservation Management</h1><div class="input-group mb-3"><asp:TextBox ID="SearchInput" runat="server" CssClass="form-control" placeholder="Search customer or status" /><asp:Button ID="SearchButton" runat="server" CssClass="btn btn-dark-green" Text="Search" OnClick="SearchButton_Click" /></div><asp:GridView ID="ReservationsGrid" runat="server" CssClass="table table-striped" AutoGenerateColumns="false" AllowPaging="true" PageSize="10" OnRowCommand="ReservationsGrid_RowCommand"><Columns><asp:BoundField DataField="ReservationId" HeaderText="ID" /><asp:BoundField DataField="CustomerName" HeaderText="Customer" /><asp:BoundField DataField="Email" HeaderText="Email" /><asp:BoundField DataField="ReservationDate" HeaderText="Date" DataFormatString="{0:dd/MM/yyyy}" /><asp:BoundField DataField="ReservationTime" HeaderText="Time" /><asp:BoundField DataField="NumberOfGuests" HeaderText="Guests" /><asp:BoundField DataField="Status" HeaderText="Status" /><asp:TemplateField HeaderText="Update"><ItemTemplate><asp:DropDownList ID="StatusSelect" runat="server" CommandArgument="<%# Container.DataItem.ReservationId %>" CssClass="form-select d-inline w-auto"><asp:ListItem Text="Pending" Value="Pending" /><asp:ListItem Text="Confirmed" Value="Confirmed" /><asp:ListItem Text="Completed" Value="Completed" /><asp:ListItem Text="Cancelled" Value="Cancelled" /></asp:DropDownList><asp:Button ID="UpdateButton" runat="server" CommandName="Update" CommandArgument="<%# Container.DataItem.ReservationId %>" CssClass="btn btn-sm btn-gold ms-1" Text="Update" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView></section></asp:Content>