<%@ Page Title="Cart" Language="C#" MasterPageFile="Site.Master" AutoEventWireup="true" CodeBehind="Cart.aspx.cs" Inherits="SpiceGardenWebForms.Cart" %>
<asp:Content ID="MainContent" runat="server" ContentPlaceHolderID="MainContent"><section class="container py-5"><h1>Shopping Cart</h1><asp:Label ID="Message" runat="server" CssClass="success-message" /><asp:GridView ID="CartGrid" runat="server" CssClass="table table-striped mt-3" AutoGenerateColumns="false" OnRowCommand="CartGrid_RowCommand"><Columns><asp:TemplateField HeaderText="Item"><ItemTemplate><%# Eval("Key.ItemName") %></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Price"><ItemTemplate><%# Eval("Key.Price", "{0:C}") %></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Quantity"><ItemTemplate><asp:Button ID="Decrease" runat="server" CommandName="Decrease" CommandArgument="<%# Container.DataItem.Key.MenuItemId %>" Text="-" CssClass="btn btn-sm btn-outline-dark" /><span class="mx-2"><%# Eval("Value") %></span><asp:Button ID="Increase" runat="server" CommandName="Increase" CommandArgument="<%# Container.DataItem.Key.MenuItemId %>" Text="+" CssClass="btn btn-sm btn-outline-dark" /></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Subtotal"><ItemTemplate><%# Eval("Key.Price", "{0:C}") %> x <%# Eval("Value") %></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Action"><ItemTemplate><asp:Button ID="Remove" runat="server" CommandName="Remove" CommandArgument="<%# Container.DataItem.Key.MenuItemId %>" Text="Remove" CssClass="btn btn-sm btn-danger" /></ItemTemplate></asp:TemplateField></Columns></asp:GridView><div class="mt-3"><asp:Button ID="ClearButton" runat="server" CssClass="btn btn-outline-danger" Text="Clear Cart" OnClick="ClearButton_Click" /><a class="btn btn-dark-green ms-2" href="Checkout.aspx">Checkout</a></div></section></asp:Content>