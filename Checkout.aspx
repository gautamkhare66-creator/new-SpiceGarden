<%@ Page Title="Checkout" Language="C#" MasterPageFile="Site.Master" AutoEventWireup="true" CodeBehind="Checkout.aspx.cs" Inherits="SpiceGardenWebForms.Checkout" %>
<asp:Content ID="MainContent" runat="server" ContentPlaceHolderID="MainContent"><section class="container py-5"><h1>Checkout</h1><asp:Label ID="Message" runat="server" CssClass="success-message" /><div class="row g-4"><div class="col-lg-7"><h3>Delivery address</h3><asp:TextBox ID="AddressInput" runat="server" CssClass="form-control" TextMode="MultiLine" Rows="4" /><asp:RequiredFieldValidator ControlToValidate="AddressInput" ErrorMessage="Delivery address is required." runat="server" /><h3 class="mt-4">Order summary</h3><asp:GridView ID="SummaryGrid" runat="server" CssClass="table" AutoGenerateColumns="false"><Columns><asp:TemplateField HeaderText="Item"><ItemTemplate><%# Eval("Key.ItemName") %></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Price"><ItemTemplate><%# Eval("Key.Price", "{0:C}") %></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Quantity"><ItemTemplate><%# Eval("Value") %></ItemTemplate></asp:TemplateField></Columns></asp:GridView><div class="fs-5 fw-bold">Total: <asp:Label ID="TotalLabel" runat="server" /></div><asp:Button ID="PlaceOrderButton" runat="server" CssClass="btn btn-dark-green mt-3" Text="Place Order" OnClick="PlaceOrderButton_Click" /></div><div class="col-lg-5"><h3>Customer information</h3><div class="card"><div class="card-body"><asp:Label ID="CustomerLabel" runat="server" /></div></div></div></div></section></asp:Content>