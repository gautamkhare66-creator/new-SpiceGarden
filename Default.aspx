<%@ Page Title="SpiceGarden Home" Language="C#" MasterPageFile="Site.Master" AutoEventWireup="true" CodeBehind="Default.aspx.cs" Inherits="SpiceGardenWebForms.Default" %>
<asp:Content ID="TitleContent" runat="server" ContentPlaceHolderID="TitleContent">SpiceGarden | Restaurant Ordering</asp:Content>
<asp:Content ID="MainContent" runat="server" ContentPlaceHolderID="MainContent">
<section class="restaurant-hero d-flex align-items-center text-white"><div class="container py-5"><div class="col-lg-8"><span class="badge bg-gold text-dark">A taste of home</span><h1 class="hero-title mt-3 fw-bold">Indian flavours,<br/>made memorable.</h1><p class="fs-5 mt-3">Order your favourites from our fresh menu or reserve a table for a relaxed family meal.</p><div class="mt-4"><a class="btn btn-gold btn-lg me-2" href="Menu.aspx">View Menu</a><a class="btn btn-outline-light btn-lg" href="Reservation.aspx">Reserve a Table</a></div></div></div></section>
<section class="container py-5"><div class="row g-4"><div class="col-12"><h2 class="text-center">Popular dishes</h2></div><asp:Repeater ID="PopularDishesRepeater" runat="server"><ItemTemplate><div class="col-sm-6 col-lg-3"><div class="card h-100 card-shadow"><img class="card-img-top card-image" src="<%# Eval("ImageUrl") %>" alt="<%# Eval("ItemName") %>" onerror="this.style.display='none';this.parentElement.classList.add('d-flex','align-items-center','justify-content-center');this.parentElement.innerHTML += '<div class=\"text-center text-muted p-4\">SpiceGarden Special</div>';"/><div class="card-body"><h5><%# Eval("ItemName") %></h5><p class="text-muted"><%# Eval("Description") %></p><div class="d-flex justify-content-between"><strong class="text-gold"><%# Eval("Price", "{0:C}") %></strong><a class="btn btn-sm btn-dark-green" href="Cart.aspx?add=<%# Eval("MenuItemId") %>">Add</a></div></div></div></div></ItemTemplate></asp:Repeater></div></section>
<section class="bg-light py-5"><div class="container"><div class="row g-4"><div class="col-md-4"><div class="card card-shadow border-0"><div class="card-body"><h4>Fresh ingredients</h4><p>Quality ingredients and authentic recipes.</p></div></div></div><div class="col-md-4"><div class="card card-shadow border-0"><div class="card-body"><h4>Fast delivery</h4><p>Warm food delivered to your door.</p></div></div></div><div class="col-md-4"><div class="card card-shadow border-0"><div class="card-body"><h4>Friendly service</h4><p>Helpful support from our restaurant team.</p></div></div></div></div></div></section>
<section class="container py-5"><div class="row align-items-center"><div class="col-lg-6"><h2>About SpiceGarden</h2><p>SpiceGarden brings traditional Indian cooking, comfortable dining, and easy online ordering together in one welcoming place. The application is built as a database-driven student project with secure authentication and an administrator dashboard.</p></div><div class="col-lg-6"><div class="bg-dark-green text-white rounded-3 p-4"><h3>Ready to dine?</h3><p>Explore the full menu or make a table reservation in minutes.</p><a class="btn btn-gold" href="Menu.aspx">Browse menu</a></div></div></div></section>
</asp:Content>