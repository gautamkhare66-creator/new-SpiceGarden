<%@ Page Title="My Orders" Language="C#" MasterPageFile="Site.Master" AutoEventWireup="true" CodeBehind="MyOrders.aspx.cs" Inherits="SpiceGardenWebForms.MyOrders" %>
<asp:Content ID="MainContent" runat="server" ContentPlaceHolderID="MainContent"><section class="container py-5"><h1>My Orders</h1><asp:GridView ID="OrdersGrid" runat="server" CssClass="table table-striped" AutoGenerateColumns="false" AllowPaging="true" PageSize="10"><Columns><asp:BoundField DataField="OrderId" HeaderText="Order ID" /><asp:BoundField DataField="OrderDate" HeaderText="Order Date" DataFormatString="{0:dd/MM/yyyy}" /><asp:TemplateField HeaderText="Total Amount"><ItemTemplate><%# Eval("TotalAmount", "{0:C}") %></ItemTemplate></asp:TemplateField><asp:BoundField DataField="Status" HeaderText="Status" /><asp:TemplateField HeaderText="Details"><ItemTemplate><a href="OrderDetails.aspx?orderId=<%# Eval("OrderId") %>">View</a></ItemTemplate></asp:TemplateField></Columns></asp:GridView></section></asp:Content>