<%@ Page Title="Register" Language="C#" MasterPageFile="Site.Master" AutoEventWireup="true" CodeBehind="Register.aspx.cs" Inherits="SpiceGardenWebForms.Register" %>
<asp:Content ID="MainContent" runat="server" ContentPlaceHolderID="MainContent"><section class="container py-5"><div class="row justify-content-center"><div class="col-lg-7"><div class="card card-shadow p-4"><h2 class="text-center">Create account</h2><asp:Form runat="server" ID="RegisterForm"><div class="row g-3"><div class="col-md-6"><label class="form-label">Full name</label><asp:TextBox ID="FullNameInput" runat="server" CssClass="form-control" /><asp:RequiredFieldValidator ControlToValidate="FullNameInput" ErrorMessage="Full name is required." runat="server" /></div><div class="col-md-6"><label class="form-label">Email</label><asp:TextBox ID="EmailInput" runat="server" CssClass="form-control" TextMode="Email" /><asp:RequiredFieldValidator ControlToValidate="EmailInput" ErrorMessage="Email is required." runat="server" /><asp:RegularExpressionValidator ControlToValidate="EmailInput" ValidationExpression="^[^@\s]+@[^@\s]+\.[^@\s]+$" ErrorMessage="Enter a valid email." runat="server" /></div><div class="col-md-6"><label class="form-label">Phone</label><asp:TextBox ID="PhoneInput" runat="server" CssClass="form-control" /></div><div class="col-md-6"><label class="form-label">Password</label><asp:TextBox ID="PasswordInput" runat="server" CssClass="form-control" TextMode="Password" /><asp:RequiredFieldValidator ControlToValidate="PasswordInput" ErrorMessage="Password is required." runat="server" /><asp:RegularExpressionValidator ControlToValidate="PasswordInput" ValidationExpression="^.{8,}$" ErrorMessage="Use at least 8 characters." runat="server" /></div><div class="col-12"><label class="form-label">Confirm password</label><asp:TextBox ID="ConfirmPasswordInput" runat="server" CssClass="form-control" TextMode="Password" /><asp:CompareValidator ControlToValidate="ConfirmPasswordInput" ControlToCompare="PasswordInput" ErrorMessage="Passwords do not match." runat="server" /></div><div class="col-12"><asp:Label ID="ErrorMessage" runat="server" CssClass="error-message" /><asp:Button ID="RegisterButton" runat="server" CssClass="btn btn-dark-green" Text="Register" OnClick="RegisterButton_Click" /></div></div></asp:Form></div></div></section></asp:Content>