<%@ Page Title="Reserve a Table" Language="C#" MasterPageFile="Site.Master" AutoEventWireup="true" CodeBehind="Reservation.aspx.cs" Inherits="SpiceGardenWebForms.Reservation" %>
<asp:Content ID="MainContent" runat="server" ContentPlaceHolderID="MainContent"><section class="container py-5"><div class="row justify-content-center"><div class="col-lg-7 card card-shadow p-4"><h2>Reserve a table</h2><asp:Form runat="server" ID="ReservationForm"><div class="row g-3"><div class="col-md-6"><label class="form-label">Customer name</label><asp:TextBox ID="CustomerNameInput" runat="server" CssClass="form-control" /><asp:RequiredFieldValidator ControlToValidate="CustomerNameInput" ErrorMessage="Customer name is required." runat="server" /></div><div class="col-md-6"><label class="form-label">Email</label><asp:TextBox ID="EmailInput" runat="server" CssClass="form-control" TextMode="Email" /><asp:RequiredFieldValidator ControlToValidate="EmailInput" ErrorMessage="Email is required." runat="server" /><asp:RegularExpressionValidator ControlToValidate="EmailInput" ValidationExpression="^[^@\s]+@[^@\s]+\.[^@\s]+$" runat="server" /></div><div class="col-md-6"><label class="form-label">Phone</label><asp:TextBox ID="PhoneInput" runat="server" CssClass="form-control" /><asp:RequiredFieldValidator ControlToValidate="PhoneInput" ErrorMessage="Phone is required." runat="server" /></div><div class="col-md-6"><label class="form-label">Date</label><asp:TextBox ID="DateInput" runat="server" CssClass="form-control" TextMode="Date" /><asp:RequiredFieldValidator ControlToValidate="DateInput" ErrorMessage="Date is required." runat="server" /><asp:RangeValidator ControlToValidate="DateInput" Type="Date" MinimumValue="<%=DateTime.Today.ToString("yyyy-MM-dd")%>" ErrorMessage="Date cannot be in the past." runat="server" /></div><div class="col-md-4"><label class="form-label">Time</label><asp:DropDownList ID="TimeInput" runat="server" CssClass="form-select"><asp:ListItem Text="17:00" Value="17:00" /><asp:ListItem Text="18:00" Value="18:00" /><asp:ListItem Text="19:00" Value="19:00" /><asp:ListItem Text="20:00" Value="20:00" /><asp:ListItem Text="21:00" Value="21:00" /></asp:DropDownList><asp:RequiredFieldValidator ControlToValidate="TimeInput" ErrorMessage="Time is required." runat="server" /></div><div class="col-md-4"><label class="form-label">Guests</label><asp:DropDownList ID="GuestsInput" runat="server" CssClass="form-select"><asp:ListItem Text="1" Value="1" /><asp:ListItem Text="2" Value="2" /><asp:ListItem Text="3" Value="3" /><asp:ListItem Text="4" Value="4" /><asp:ListItem Text="5" Value="5" /><asp:ListItem Text="6" Value="6" /><asp:ListItem Text="7" Value="7" /><asp:ListItem Text="8" Value="8" /></asp:DropDownList><asp:RangeValidator ControlToValidate="GuestsInput" Type="Integer" MinimumValue="1" MaximumValue="20" ErrorMessage="Guests must be between 1 and 20." runat="server" /></div><div class="col-md-4"><label class="form-label">Special request</label><asp:TextBox ID="SpecialRequestInput" runat="server" CssClass="form-control" /></div><div class="col-12"><asp:Label ID="ErrorMessage" runat="server" CssClass="error-message" /><asp:Button ID="ReserveButton" runat="server" CssClass="btn btn-dark-green" Text="Reserve Table" OnClick="ReserveButton_Click" /></div></div></asp:Form></div></div></section></asp:Content>