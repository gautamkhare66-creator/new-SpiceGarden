<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="system.web" type="System.Web.Configuration.SystemWebConfigurationSectionGroup, System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" />
  </configSections>
  <connectionStrings>
    <add name="RestaurantDBConnection" connectionString="Data Source=.;Initial Catalog=RestaurantDB;Integrated Security=True;MultiSubnetFailover=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <sessionState mode="InProc" timeout="20" />
    <pages enableEventValidation="true" controlRenderingVersion="4.0" />
    <httpModules>
      <add name="FormsAuthentication" type="System.Web.FormsAuthenticationModule, System.Web" />
    </httpModules>
  </system.web>
</configuration>
